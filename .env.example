# ==============================================================================
# YATRA-LEKHA v2.0 - PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION
# Next-Gen Autonomous Heavy-Haul Commercial Transport OS & Marketplace
# Zero-Cost Free-Tier Deployment Stack: Neon + Render + Vercel + Cloudflare R2
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & PORT BINDINGS (Render / Local)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
# Optional TCP AIS-140 Raw Telematics Port (binds port 5179 locally)
AIS140_PORT=5179

# ------------------------------------------------------------------------------
# 2. NEON CLOUD POSTGRESQL (Serverless Free-Tier with SSL)
# Create a free project at https://neon.tech
# Neon connection string format (sslmode=require is handled automatically by pg Pool):
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_secret@ep-cool-fog-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & MULTI-TENANT JWT
# Generate a cryptographically random secret (e.g. `openssl rand -hex 32`)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_production_jwt_signing_key_change_me_9822001122

# ------------------------------------------------------------------------------
# 4. CORS & FRONTEND CLIENT URLS (Vercel Production Domain)
# Allow cross-origin requests from your live Vercel frontend:
# ------------------------------------------------------------------------------
FRONTEND_URL=https://yatralekha-v2.vercel.app

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI BRAIN (Yatra-Mitra Voice Copilot)
# Get a free API key at https://aistudio.google.com/
# Powers real-time fleet conversational intelligence in Hindi, Marathi & English.
# Note: If omitted, Yatra-Mitra automatically uses the built-in deterministic transport AI engine.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyD-your-google-gemini-api-key-here

# ------------------------------------------------------------------------------
# 6. ENCRYPTED COMPLIANCE VAULT (Cloudflare R2 / Supabase Storage S3-Compatible)
# Free tier: Cloudflare R2 offers 10GB free storage & zero egress fees.
# If omitted, uploaded RTO certificates automatically fall back to local disk / bytea storage.
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=yatralekha-vault
S3_ACCESS_KEY=your_r2_access_key_id
S3_SECRET_KEY=your_r2_secret_access_key
S3_REGION=auto
# Optional custom public domain (e.g. https://vault.yatralekha.in)
S3_PUBLIC_DOMAIN=

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE (Nodemailer / Gmail SMTP for Password Recovery OTP)
# Generate a Google App Password at: https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-app-password
SMTP_FROM="YatraLekha Fleet Security <no-reply@yatralekha.in>"

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT CONFIGURATION (Vercel Environment Variable)
# In your Vercel project settings, set VITE_API_URL to your Render live API URL:
# ------------------------------------------------------------------------------
VITE_API_URL=https://yatralekha-api.onrender.com
